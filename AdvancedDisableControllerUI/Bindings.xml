<Bindings>
    <Layer name="SI_KEYBINDINGS_CATEGORY_GENERAL">
        <Category name="SI_KEYBINDINGS_CATEGORY_ADCUI">
            <Action name="ADCUI_TOGGLE_UI">
                <Down>ADCUI:ToggleUI()</Down>
            </Action>
            <Action name="ADCUI_TOGGLE_BUTTONS">
                <Down>ADCUI:ToggleButtons()</Down>
            </Action>
            <Action name="ADCUI_TOGGLE_ACTION_BAR">
                <Down>ADCUI:ToggleActionBar()</Down>
            </Action>
            <Action name="ADCUI_TOGGLE_RESOURCE_BARS">
                <Down>ADCUI:ToggleResourceBars()</Down>
            </Action>
            <Action name="ADCUI_TOGGLE_COMPASS_LOCK">
                <Down>ADCUI:ToggleCompassLock()</Down>
            </Action>
        </Category>
    </Layer>

    <Layer name="ADCUI_UTILITY_WHEEL_BRIDGE" allowFallthrough="true">
        <Category name="SI_KEYBINDINGS_CATEGORY_UTILITY_WHEEL_GAMEPAD">
            <Action name="ADCUI_UTILITY_WHEEL_CYCLE_LEFT">
                <Down>if ADCUI and ADCUI:ShouldBridgeUtilityWheelInput() then return ADCUI:CycleUtilityWheel(-1) end return false</Down>
            </Action>
            <Action name="ADCUI_UTILITY_WHEEL_CYCLE_RIGHT">
                <Down>if ADCUI and ADCUI:ShouldBridgeUtilityWheelInput() then return ADCUI:CycleUtilityWheel(1) end return false</Down>
            </Action>
        </Category>
    </Layer>
</Bindings>
